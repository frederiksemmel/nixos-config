#!/usr/bin/env bash
set -euo pipefail

. "$(dirname "$0")/lib.sh"

mapfile -d '' -t files < <(git diff --cached --name-only -z --diff-filter=ACMR)
[ "${#files[@]}" -gt 0 ] || exit 0

printf '%s\0' "${files[@]}" | check_hidden_dirs pre-commit

gitleaks="$(gitleaks_bin)"
if ! "$gitleaks" git --pre-commit --staged --no-banner --redact --log-level warn -v .; then
  echo "pre-commit: gitleaks found what looks like a secret in the staged changes (above)." >&2
  echo "Put real secrets in secrets/*.age. For a false positive, extend .gitleaks.toml." >&2
  exit 1
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

if ! treefmt="$(nix formatter build --no-link 2>"$tmp/nix.log")"; then
  cat "$tmp/nix.log" >&2
  exit 1
fi

unformatted=()
for f in "${files[@]}"; do
  git show ":$f" >"$tmp/staged"
  if ! "$treefmt" --quiet --stdin "$f" <"$tmp/staged" >"$tmp/formatted" ||
    ! cmp -s "$tmp/staged" "$tmp/formatted"; then
    unformatted+=("$f")
  fi
done

if [ "${#unformatted[@]}" -gt 0 ]; then
  echo "pre-commit: staged content is not formatted; run 'nix fmt' and stage the result:" >&2
  printf '  %s\n' "${unformatted[@]}" >&2
  exit 1
fi
