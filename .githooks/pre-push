#!/usr/bin/env bash
# Rechecks every commit the push would publish, including ones committed with
# --no-verify or before the pre-commit checks existed.
set -euo pipefail

. "$(dirname "$0")/lib.sh"

zero=0000000000000000000000000000000000000000

while read -r _ local_sha _ _; do
  [ "$local_sha" != "$zero" ] || continue
  [ -n "$(git rev-list -n 1 "$local_sha" --not --remotes)" ] || continue

  git log -z --format= --name-only --diff-filter=ACMR "$local_sha" --not --remotes |
    check_hidden_dirs pre-push

  # kingfisher takes one commit to stop at; any commit on the boundary to the
  # remotes covers every new commit.
  range=(--branch "$local_sha")
  base="$(git rev-list --boundary "$local_sha" --not --remotes | awk 'sub(/^-/, "") && !n++')"
  [ -z "$base" ] || range+=(--since-commit "$base")

  if ! kingfisher_scan pre-push "${range[@]}"; then
    echo "Rewrite those commits before pushing. For a false positive, extend kingfisher_skip in .githooks/lib.sh." >&2
    exit 1
  fi
done
