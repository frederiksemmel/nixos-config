import "@fonts/InterVariable.ttf";

export enum OfflineState {
    unknown,
    remote,
    downloading,
    partial,
    downloaded,
}

export struct RatingsData {
    imdb: string,
    rt: string,
    fresh: bool,
    popcorn: string,
    full: bool,
}

export struct CardData {
    key: string,
    title: string,
    detail: string,
    ratings: RatingsData,
    art: image,
    has-art: bool,
    tint-a: color,
    tint-b: color,
    offline: OfflineState,
    offline-text: string,
    progress: float,
}

export struct ShelfData {
    title: string,
    cards: [CardData],
}

export struct HeatCell {
    text: string,
    fill: color,
    ink: color,
    rated: bool,
    season: int,
    episode: int,
}

export struct HeatRow {
    title: string,
    cells: [HeatCell],
}

export struct HeatmapData {
    rows: [HeatRow],
    columns: int,
    rated: int,
    legend: [HeatCell],
    hint: string,
}

export struct HeatFocus {
    active: bool,
    season: int,
    episode: int,
    title: string,
    place: string,
    rank: string,
    ratings: RatingsData,
}

component RatingBadges inherits HorizontalLayout {
    in property <length> u;
    in property <RatingsData> ratings;
    in property <float> scale: 1;
    in property <color> ink: #c3c7d1;
    property <length> s: self.u * self.scale;

    spacing: 9 * root.s;
    alignment: start;

    if root.ratings.rt != "" && root.ratings.fresh: Rectangle {
        width: 28 * root.s;

        Path {
            y: -2 * root.s;
            width: 28 * root.s;
            height: 28 * root.s;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: #fa320a;
            commands: "M12 6C17.6 6 22 9.6 22 14.3C22 19.2 17.6 22.6 12 22.6C6.4 22.6 2 19.2 2 14.3C2 9.6 6.4 6 12 6Z";
        }

        Path {
            y: -2 * root.s;
            width: 28 * root.s;
            height: 28 * root.s;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: #0ac855;
            commands: "M12 4.4L13.4 6.2L16.9 5.5L14.7 7.5L16.3 9.5L12.9 8.6L12 10.3L11.1 8.6L7.7 9.5L9.3 7.5L7.1 5.5L10.6 6.2ZM11.5 5.2L11.9 1.8L12.9 1.8L12.5 5.2Z";
        }
    }

    if root.ratings.rt != "" && !root.ratings.fresh: Rectangle {
        width: 28 * root.s;

        Path {
            y: -2 * root.s;
            width: 28 * root.s;
            height: 28 * root.s;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: #0ac855;
            commands: "M12 3.2L13.6 7.4L17.6 3.8L16.6 8.9L22 8.4L18 12.2L22.4 15.6L16.8 16L18.6 21.2L13.9 18L12 22.8L10.1 18L5.2 21.4L7.2 16L1.6 15.4L6.1 12.1L2.2 8.2L7.5 8.9L6.4 3.8L10.4 7.4Z";
        }
    }

    if root.ratings.rt != "": Text {
        text: root.ratings.rt;
        color: root.ink;
        font-size: 24 * root.s;
        font-weight: 600;
        vertical-alignment: center;
    }

    if root.ratings.rt != "" && root.ratings.popcorn != "": Rectangle {
        width: 4 * root.s;
    }

    if root.ratings.popcorn != "" && root.ratings.full: Rectangle {
        width: 28 * root.s;

        Path {
            y: -2 * root.s;
            width: 28 * root.s;
            height: 28 * root.s;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: #fa320a;
            commands: "M4.4 10.6L19.6 10.6L17.7 22.6L6.3 22.6Z";
        }

        Path {
            y: -2 * root.s;
            width: 28 * root.s;
            height: 28 * root.s;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: #ffffff;
            commands: "M8.4 10.6L10.2 10.6L10.6 22.6L9.1 22.6ZM13.8 10.6L15.6 10.6L14.9 22.6L13.4 22.6Z";
        }

        Path {
            y: -2 * root.s;
            width: 28 * root.s;
            height: 28 * root.s;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: #fde7a4;
            commands: "M3.6 10.4A2.8 2.8 0 1 1 9.2 10.4ZM7 8.2A3.1 3.1 0 1 1 13.2 8.2A3.1 3.1 0 1 1 7 8.2ZM10.8 8.2A3.1 3.1 0 1 1 17 8.2A3.1 3.1 0 1 1 10.8 8.2ZM14.8 10.4A2.8 2.8 0 1 1 20.4 10.4Z";
        }
    }

    if root.ratings.popcorn != "" && !root.ratings.full: Rectangle {
        width: 28 * root.s;

        Path {
            y: -2 * root.s;
            width: 28 * root.s;
            height: 28 * root.s;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: #0ac855;
            commands: "M2 14.6L14.6 8.2L14.6 21.4L2 21.4Z";
        }

        Path {
            y: -2 * root.s;
            width: 28 * root.s;
            height: 28 * root.s;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: #c9f4d8;
            commands: "M2 16.6L14.6 12.2L14.6 13.9L2 17.6ZM2 19L14.6 16.6L14.6 18.3L2 19.8Z";
        }

        Path {
            y: -2 * root.s;
            width: 28 * root.s;
            height: 28 * root.s;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: #067a33;
            commands: "M14.6 8.2A1.7 6.6 0 1 1 14.6 21.4A1.7 6.6 0 1 1 14.6 8.2Z";
        }

        Path {
            y: -2 * root.s;
            width: 28 * root.s;
            height: 28 * root.s;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: #fde7a4;
            stroke: #0b0d12;
            stroke-width: 0.6 * root.s;
            commands: "M15.2 19.2A2.2 2.2 0 1 1 19.6 19.2A2.2 2.2 0 1 1 15.2 19.2ZM19.2 20.2A1.8 1.8 0 1 1 22.8 20.2A1.8 1.8 0 1 1 19.2 20.2ZM15.4 15A2 2 0 1 1 19.4 15A2 2 0 1 1 15.4 15ZM18.8 16.6A1.6 1.6 0 1 1 22 16.6A1.6 1.6 0 1 1 18.8 16.6Z";
        }
    }

    if root.ratings.popcorn != "": Text {
        text: root.ratings.popcorn;
        color: root.ink;
        font-size: 24 * root.s;
        font-weight: 600;
        vertical-alignment: center;
    }

    if (root.ratings.rt != "" || root.ratings.popcorn != "") && root.ratings.imdb != "": Rectangle {
        width: 4 * root.s;
    }

    if root.ratings.imdb != "": Rectangle {
        width: 52 * root.s;
        height: 24 * root.s;
        y: 3 * root.s;
        border-radius: 4 * root.s;
        background: #f5c518;

        Text {
            text: "IMDb";
            color: #000000;
            font-size: 16 * root.s;
            font-weight: 900;
            letter-spacing: -0.3 * root.s;
        }
    }

    if root.ratings.imdb != "": Text {
        text: root.ratings.imdb;
        color: root.ink;
        font-size: 24 * root.s;
        font-weight: 600;
        vertical-alignment: center;
    }

}

component OfflineBadge {
    in property <length> u;
    in property <OfflineState> state;
    in property <string> text;

    property <color> dot: self.state == OfflineState.downloaded ? #58d68d
        : self.state == OfflineState.partial ? #58d68d
        : self.state == OfflineState.downloading ? #f5c04e
        : #8a909c;
    property <bool> hollow: self.state == OfflineState.remote;

    visible: self.state != OfflineState.unknown;
    width: label.preferred-width + 54 * self.u;
    height: 40 * self.u;

    Rectangle {
        border-radius: 20 * root.u;
        background: #000000a8;
    }

    Rectangle {
        x: 16 * root.u;
        y: 12 * root.u;
        width: 16 * root.u;
        height: 16 * root.u;
        border-radius: 8 * root.u;
        background: root.hollow ? transparent : root.dot;
        border-width: root.hollow ? 2 * root.u : 0;
        border-color: root.dot;
    }

    label := Text {
        x: 42 * root.u;
        height: 100%;
        text: root.text;
        color: root.hollow ? #c9cdd6 : white;
        font-size: 22 * root.u;
        font-weight: 500;
        vertical-alignment: center;
    }
}

component CardView {
    in property <length> u;
    in property <CardData> card;
    in property <bool> focused;

    Rectangle {
        y: 0;
        width: 100%;
        height: 225 * u;
        transform-scale: root.focused ? 1.1 : 1;
        animate transform-scale { duration: 180ms; easing: ease-out-quint; }

        Rectangle {
            border-radius: 14 * u;
            clip: true;
            background: @linear-gradient(135deg, root.card.tint-a 0%, root.card.tint-b 100%);

            if !root.card.has-art: Text {
                x: 28 * u;
                width: parent.width - 56 * u;
                text: root.card.title;
                color: white;
                font-size: 40 * u;
                font-weight: 700;
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: center;
            }

            if root.card.has-art: Image {
                width: 100%;
                height: 100%;
                source: root.card.art;
                image-fit: cover;
            }

            Rectangle {
                background: black;
                opacity: root.focused ? 0 : 0.3;
                animate opacity { duration: 180ms; }
            }

            if root.card.progress > 0: Rectangle {
                x: 18 * u;
                y: parent.height - 24 * u;
                width: parent.width - 36 * u;
                height: 6 * u;
                border-radius: 3 * u;
                background: #ffffff55;

                Rectangle {
                    x: 0;
                    width: max(6 * u, parent.width * root.card.progress);
                    border-radius: 3 * u;
                    background: white;
                }
            }
        }

        Rectangle {
            border-radius: 14 * u;
            border-width: 5 * u;
            border-color: white;
            opacity: root.focused ? 1 : 0;
            animate opacity { duration: 120ms; }
        }

        OfflineBadge {
            x: 12 * root.u;
            y: parent.height - self.height - (root.card.progress > 0 ? 40 : 12) * root.u;
            u: root.u;
            state: root.card.offline;
            text: root.card.offline-text;
        }
    }

    Text {
        x: 0;
        y: 248 * u;
        width: 100%;
        text: root.card.has-art ? root.card.title : "";
        color: root.focused ? white : #a8adb8;
        font-size: 30 * u;
        font-weight: root.focused ? 600 : 500;
        overflow: elide;
    }

    Text {
        x: 0;
        y: root.card.has-art ? 290 * u : 248 * u;
        width: 100%;
        text: root.card.detail;
        color: #7d8391;
        font-size: 24 * u;
        overflow: elide;
    }

    if root.card.ratings.imdb != "" || root.card.ratings.rt != "": RatingBadges {
        x: 0;
        y: (root.card.has-art ? 292 : 250) * root.u;
        height: 30 * root.u;
        u: root.u;
        ratings: root.card.ratings;
        ink: root.focused ? white : #a8adb8;
    }
}

component ShelfRow {
    in property <length> u;
    in property <ShelfData> shelf;
    in property <int> focus-col;
    in property <bool> active;

    property <length> step: 436 * u;
    property <length> content-width: self.shelf.cards.length * self.step - 36 * u;
    property <length> max-offset: max(0px, self.content-width - self.width);
    property <length> offset: min(max(0, self.focus-col - 1) * self.step, self.max-offset);

    Text {
        x: 0;
        y: 0;
        text: root.shelf.title;
        color: root.active ? white : #c9cdd6;
        font-size: 42 * u;
        font-weight: 700;
    }

    Rectangle {
        x: -root.offset;
        y: 84 * u;
        width: root.content-width;
        height: root.height - 84 * u;
        animate x { duration: 240ms; easing: ease-out-quint; }

        for card[index] in root.shelf.cards: CardView {
            x: index * root.step;
            y: 0;
            width: 400 * root.u;
            height: 330 * root.u;
            u: root.u;
            card: card;
            focused: root.active && index == root.focus-col;
        }
    }
}

component ShelfStack {
    in property <length> u;
    in property <[ShelfData]> shelves;
    in property <int> focus-row;
    in property <[int]> focus-cols;
    in property <bool> active;

    property <length> step: 444 * u;
    property <length> content-height: self.shelves.length * self.step + 16 * u;
    property <length> max-offset: max(0px, self.content-height - self.height);

    Rectangle {
        x: 0;
        y: -min(root.focus-row * root.step, root.max-offset);
        width: 100%;
        height: root.content-height;
        animate y { duration: 280ms; easing: ease-out-quint; }

        for shelf[index] in root.shelves: ShelfRow {
            x: 0;
            y: index * root.step;
            width: parent.width;
            height: 414 * root.u;
            u: root.u;
            shelf: shelf;
            focus-col: root.focus-cols[index];
            active: root.active && index == root.focus-row;
        }
    }
}

component Heatmap {
    in property <length> u;
    in property <HeatmapData> data;
    in property <HeatFocus> current;
    in property <bool> active;

    property <length> head: 84 * self.u;
    property <length> panel: 500 * self.u;
    property <length> labels: 64 * self.u;
    property <length> numbers: 40 * self.u;
    property <length> grid-width: self.width - self.panel - 56 * self.u;
    property <length> grid-height: self.height - self.head - self.numbers;
    property <length> cell: min(96 * self.u,
        (self.grid-width - self.labels) / max(1, self.data.columns),
        self.grid-height / max(1, self.data.rows.length));
    property <length> gap: max(2px, self.cell * 0.08);
    property <bool> roomy: self.cell >= 50 * self.u;

    Text {
        x: 0;
        y: 0;
        text: "Episode ratings";
        color: root.active ? white : #c9cdd6;
        font-size: 42 * root.u;
        font-weight: 700;
    }

    for number in root.data.columns: Text {
        x: root.labels + number * root.cell;
        y: root.head;
        width: root.cell - root.gap;
        height: root.numbers - 6 * root.u;
        visible: root.cell >= 36 * root.u || mod(number + 1, 5) == 0 || number == 0;
        text: number + 1;
        color: #7d8391;
        font-size: 20 * root.u;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    for row[index] in root.data.rows: Rectangle {
        x: 0;
        y: root.head + root.numbers + index * root.cell;
        width: root.labels + root.data.columns * root.cell;
        height: root.cell;

        Text {
            x: 0;
            width: root.labels - 12 * root.u;
            height: root.cell - root.gap;
            text: row.title;
            color: #a8adb8;
            font-size: min(26 * root.u, max(14 * root.u, root.cell * 0.4));
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        for cell[column] in row.cells: Rectangle {
            property <bool> focused: root.active && root.current.active
                && cell.season == root.current.season && cell.episode == root.current.episode;

            x: root.labels + column * root.cell;
            y: 0;
            width: root.cell - root.gap;
            height: root.cell - root.gap;
            border-radius: min(10 * root.u, root.cell * 0.14);
            background: cell.rated ? cell.fill : #171a22;
            border-width: self.focused ? max(3px, 5 * root.u) : (cell.rated ? 0 : 1px);
            border-color: self.focused ? white : #262a35;
            drop-shadow-blur: self.focused ? 24 * root.u : 0;
            drop-shadow-color: #000000cc;
            z: self.focused ? 1 : 0;
            transform-scale: self.focused ? 1.18 : 1;
            animate transform-scale { duration: 160ms; easing: ease-out-quint; }

            if cell.rated && root.roomy: Text {
                text: cell.text;
                color: cell.ink;
                font-size: min(30 * root.u, root.cell * 0.36);
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    Rectangle {
        x: root.width - root.panel;
        y: root.head;
        width: root.panel;
        height: root.height - root.head;

        VerticalLayout {
            alignment: start;
            spacing: 12 * root.u;

            Text {
                text: root.current.active ? root.current.rank : root.data.rated + " episodes rated on IMDb";
                color: #f5c518;
                font-size: 24 * root.u;
                font-weight: 700;
            }

            if root.current.active: Text {
                text: root.current.title;
                color: white;
                font-size: 40 * root.u;
                font-weight: 700;
                wrap: word-wrap;
            }

            if root.current.active: Text {
                text: root.current.place;
                color: #a8adb8;
                font-size: 26 * root.u;
            }

            if root.current.active: RatingBadges {
                height: 44 * root.u;
                u: root.u;
                scale: 1.4;
                ratings: root.current.ratings;
                ink: white;
            }

            Text {
                text: root.current.active ? root.data.hint + " · OK plays" : "Press ▼ for the best episode";
                color: #7d8391;
                font-size: 22 * root.u;
            }

            Rectangle {
                height: 20 * root.u;
            }

            for band in root.data.legend: HorizontalLayout {
                spacing: 14 * root.u;
                height: 30 * root.u;

                Rectangle {
                    width: 26 * root.u;
                    height: 26 * root.u;
                    y: 2 * root.u;
                    border-radius: 6 * root.u;
                    background: band.fill;
                }

                Text {
                    text: band.text;
                    color: #a8adb8;
                    font-size: 22 * root.u;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component ShowStack {
    in property <length> u;
    in property <[ShelfData]> shelves;
    in property <int> focus-row;
    in property <[int]> focus-cols;
    in property <bool> active;
    in property <HeatmapData> heatmap;
    in property <HeatFocus> heat;

    property <length> step: 444 * u;
    property <bool> has-heat: self.heatmap.rated > 0;
    property <length> heat-height: self.height - 72 * u;
    property <length> shelves-height: self.shelves.length * self.step;
    property <length> content-height: self.shelves-height + (self.has-heat ? self.heat-height : 16 * u);
    property <length> max-offset: max(0px, self.content-height - self.height);

    Rectangle {
        x: 0;
        y: root.heat.active ? -root.shelves-height
            : -min(root.focus-row * root.step, root.max-offset);
        width: 100%;
        height: root.content-height;
        animate y { duration: 280ms; easing: ease-out-quint; }

        for shelf[index] in root.shelves: ShelfRow {
            x: 0;
            y: index * root.step;
            width: parent.width;
            height: 414 * root.u;
            u: root.u;
            shelf: shelf;
            focus-col: root.focus-cols[index];
            active: root.active && !root.heat.active && index == root.focus-row;
        }

        if root.has-heat: Heatmap {
            x: 0;
            y: root.shelves-height;
            width: parent.width;
            height: root.heat-height;
            u: root.u;
            data: root.heatmap;
            current: root.heat;
            active: root.active && root.heat.active;
        }
    }
}

component Toast inherits Rectangle {
    in property <length> u;
    in property <string> heading;
    in property <string> text;
    in property <bool> voice;
    in property <bool> busy;

    border-radius: 32 * root.u;
    background: #232733;
    border-width: 1px;
    border-color: #ffffff1a;
    drop-shadow-blur: 32 * root.u;
    drop-shadow-color: #00000099;

    HorizontalLayout {
        padding-left: (root.voice ? 36 : 44) * root.u;
        padding-right: 44 * root.u;
        padding-top: 24 * root.u;
        padding-bottom: 26 * root.u;
        spacing: 24 * root.u;

        if root.voice: VerticalLayout {
            alignment: center;

            Rectangle {
                width: 22 * root.u;
                height: 22 * root.u;
                border-radius: self.width / 2;
                background: root.busy ? white : #8f95a3;
                opacity: root.busy ? 0.55 + 0.45 * sin(animation-tick() / 1.2s * 360deg) : 1;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 6 * root.u;

            if root.heading != "": Text {
                text: root.heading;
                color: #a8adb8;
                font-size: 26 * root.u;
                horizontal-alignment: root.voice ? left : center;
                wrap: word-wrap;
            }

            Text {
                text: root.text;
                color: white;
                font-size: 32 * root.u;
                font-weight: 500;
                horizontal-alignment: root.voice ? left : center;
                wrap: word-wrap;
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <[ShelfData]> home-shelves;
    in property <int> home-row;
    in property <[int]> home-cols;

    in property <bool> show-open;
    in property <string> show-title;
    in property <string> show-subtitle;
    in property <[ShelfData]> show-shelves;
    in property <int> show-row;
    in property <[int]> show-cols;
    in property <HeatmapData> show-heatmap;
    in property <HeatFocus> show-heat;

    in property <string> message;
    in property <string> voice-transcript;
    in property <string> voice-status;
    in property <bool> voice-busy;
    in property <string> empty-note;
    in property <bool> tmdb-notice;
    in property <string> details;
    in property <RatingsData> ratings;

    callback key(string) -> bool;
    callback remote-input();
    callback voice-heard();
    callback changed();
    callback playback-finished(bool, bool);
    callback position-saved();

    property <length> u: self.height / 1080;
    in property <bool> painted;
    property <bool> splash-in;
    property <bool> splash-out;

    title: "SemmelTV";
    no-frame: true;
    preferred-width: 1280px;
    preferred-height: 720px;
    background: #0b0d12;
    default-font-family: "Inter Variable";
    forward-focus: scope;

    scope := FocusScope {
        key-pressed(event) => {
            root.key(event.text) ? accept : reject
        }

        Image {
            x: 96 * root.u;
            y: 40 * root.u;
            height: 52 * root.u;
            width: self.height * self.source.width / self.source.height;
            source: @image-url("../../assets/logo/semmeltv-dark.png");
            opacity: root.show-open || root.home-row > 0 ? 0 : 1;
            animate opacity { duration: 200ms; }
        }

        home := ShelfStack {
            x: 96 * root.u;
            y: 132 * root.u;
            width: parent.width - 192 * root.u;
            height: parent.height - 188 * root.u;
            u: root.u;
            shelves: root.home-shelves;
            focus-row: root.home-row;
            focus-cols: root.home-cols;
            active: !root.show-open;
            opacity: root.show-open ? 0 : 1;
            animate opacity { duration: 200ms; }
        }

        if root.empty-note != "" && !root.show-open: VerticalLayout {
            alignment: center;
            spacing: 24 * root.u;
            padding-left: 200 * root.u;
            padding-right: 200 * root.u;

            Image {
                height: 200 * root.u;
                source: @image-url("../../assets/logo/semmel.png");
                image-fit: contain;
            }

            Text {
                text: "Nothing to watch yet";
                color: white;
                font-size: 56 * root.u;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: root.empty-note;
                color: #a8adb8;
                font-size: 32 * root.u;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        Rectangle {
            opacity: root.show-open ? 1 : 0;
            animate opacity { duration: 200ms; }

            ShowStack {
                x: 96 * root.u;
                y: 236 * root.u;
                width: parent.width - 192 * root.u;
                height: parent.height - 292 * root.u;
                u: root.u;
                shelves: root.show-shelves;
                focus-row: root.show-row;
                focus-cols: root.show-cols;
                active: root.show-open;
                heatmap: root.show-heatmap;
                heat: root.show-heat;
            }

            Rectangle {
                y: 0;
                height: 236 * root.u;
                background: #0b0d12;
            }

            Text {
                x: 96 * root.u;
                y: 60 * root.u;
                text: root.show-title;
                color: white;
                font-size: 68 * root.u;
                font-weight: 700;
            }

            Text {
                x: 96 * root.u;
                y: 144 * root.u;
                text: root.show-subtitle;
                color: #a8adb8;
                font-size: 30 * root.u;
            }
        }

        Rectangle {
            y: parent.height - 120 * root.u;
            height: 24 * root.u;
            background: @linear-gradient(0deg, #0b0d12 0%, #0b0d1200 100%);
        }

        Rectangle {
            y: parent.height - 96 * root.u;
            height: 96 * root.u;
            background: #0b0d12;

            HorizontalLayout {
                x: 96 * root.u;
                y: 12 * root.u;
                width: parent.width - 192 * root.u;
                height: 30 * root.u;
                spacing: 9 * root.u;
                alignment: start;

                if root.ratings.imdb != "" || root.ratings.rt != "" || root.ratings.popcorn != "": RatingBadges {
                    u: root.u;
                    ratings: root.ratings;
                }

                if (root.ratings.imdb != "" || root.ratings.rt != "" || root.ratings.popcorn != "") && root.details != "": Text {
                    text: "·";
                    color: #8f95a3;
                    font-size: 24 * root.u;
                    vertical-alignment: center;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.details;
                    color: #8f95a3;
                    font-size: 24 * root.u;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if root.tmdb-notice && !root.show-open: Text {
                x: 96 * root.u;
                y: 52 * root.u;
                text: "This application uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB.";
                color: #6c7280;
                font-size: 18 * root.u;
            }
        }

        voice-toast := Toast {
            u: root.u;
            visible: root.voice-status != "";
            heading: root.voice-transcript;
            text: root.voice-status;
            voice: true;
            busy: root.voice-busy;
            width: min(self.preferred-width, parent.width - 384 * root.u, 1200 * root.u);
            height: self.preferred-height;
            x: (parent.width - self.width) / 2;
            y: parent.height - 160 * root.u - self.height;
        }

        Toast {
            u: root.u;
            visible: root.message != "";
            text: root.message;
            width: min(self.preferred-width, parent.width - 384 * root.u, 1200 * root.u);
            height: self.preferred-height;
            x: (parent.width - self.width) / 2;
            y: parent.height - 160 * root.u - self.height
                - (voice-toast.visible ? voice-toast.height + 24 * root.u : 0);
        }
    }

    Timer {
        interval: 150ms;
        running: root.painted && !root.splash-in;
        triggered => {
            root.splash-in = true;
        }
    }

    Timer {
        interval: 650ms;
        running: root.splash-in && !root.splash-out;
        triggered => {
            root.splash-out = true;
        }
    }

    Rectangle {
        background: root.background;
        opacity: root.splash-out ? 0 : 1;
        visible: self.opacity > 0;
        animate opacity { duration: 350ms; easing: ease-in-quad; }

        Image {
            source: @image-url("../../assets/logo/semmeltv-dark.png");
            height: (root.splash-in ? 220 : 88) * root.u;
            width: self.height * self.source.width / self.source.height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            opacity: root.splash-in ? 1 : 0;
            animate opacity { duration: 200ms; }
            animate height { duration: 450ms; easing: ease-out-back; }
        }
    }
}
