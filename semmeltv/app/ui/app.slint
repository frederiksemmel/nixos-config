import "@fonts/InterVariable.ttf";

export enum OfflineState {
    unknown,
    remote,
    downloading,
    partial,
    downloaded,
}

export struct CardData {
    key: string,
    title: string,
    detail: string,
    art: image,
    has-art: bool,
    tint-a: color,
    tint-b: color,
    offline: OfflineState,
    offline-text: string,
}

export struct RatingsData {
    imdb: string,
    rt: string,
    fresh: bool,
}

export struct ShelfData {
    title: string,
    cards: [CardData],
}

component OfflineBadge {
    in property <length> u;
    in property <OfflineState> state;
    in property <string> text;

    property <color> dot: self.state == OfflineState.downloaded ? #58d68d
        : self.state == OfflineState.partial ? #58d68d
        : self.state == OfflineState.downloading ? #f5c04e
        : #8a909c;
    property <bool> hollow: self.state == OfflineState.remote;

    visible: self.state != OfflineState.unknown;
    width: label.preferred-width + 54 * self.u;
    height: 40 * self.u;

    Rectangle {
        border-radius: 20 * root.u;
        background: #000000a8;
    }

    Rectangle {
        x: 16 * root.u;
        y: 12 * root.u;
        width: 16 * root.u;
        height: 16 * root.u;
        border-radius: 8 * root.u;
        background: root.hollow ? transparent : root.dot;
        border-width: root.hollow ? 2 * root.u : 0;
        border-color: root.dot;
    }

    label := Text {
        x: 42 * root.u;
        height: 100%;
        text: root.text;
        color: root.hollow ? #c9cdd6 : white;
        font-size: 22 * root.u;
        font-weight: 500;
        vertical-alignment: center;
    }
}

component CardView {
    in property <length> u;
    in property <CardData> card;
    in property <bool> focused;

    Rectangle {
        y: 0;
        width: 100%;
        height: 225 * u;
        transform-scale: root.focused ? 1.1 : 1;
        animate transform-scale { duration: 180ms; easing: ease-out-quint; }

        Rectangle {
            border-radius: 14 * u;
            clip: true;
            background: @linear-gradient(135deg, root.card.tint-a 0%, root.card.tint-b 100%);

            if !root.card.has-art: Text {
                x: 28 * u;
                width: parent.width - 56 * u;
                text: root.card.title;
                color: white;
                font-size: 40 * u;
                font-weight: 700;
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: center;
            }

            if root.card.has-art: Image {
                width: 100%;
                height: 100%;
                source: root.card.art;
                image-fit: cover;
            }

            Rectangle {
                background: black;
                opacity: root.focused ? 0 : 0.3;
                animate opacity { duration: 180ms; }
            }
        }

        Rectangle {
            border-radius: 14 * u;
            border-width: 5 * u;
            border-color: white;
            opacity: root.focused ? 1 : 0;
            animate opacity { duration: 120ms; }
        }

        OfflineBadge {
            x: 12 * root.u;
            y: parent.height - self.height - 12 * root.u;
            u: root.u;
            state: root.card.offline;
            text: root.card.offline-text;
        }
    }

    Text {
        x: 0;
        y: 248 * u;
        width: 100%;
        text: root.card.has-art ? root.card.title : "";
        color: root.focused ? white : #a8adb8;
        font-size: 30 * u;
        font-weight: root.focused ? 600 : 500;
        overflow: elide;
    }

    Text {
        x: 0;
        y: root.card.has-art ? 290 * u : 248 * u;
        width: 100%;
        text: root.card.detail;
        color: #7d8391;
        font-size: 24 * u;
        overflow: elide;
    }
}

component ShelfRow {
    in property <length> u;
    in property <ShelfData> shelf;
    in property <int> focus-col;
    in property <bool> active;

    property <length> step: 436 * u;
    property <length> content-width: self.shelf.cards.length * self.step - 36 * u;
    property <length> max-offset: max(0px, self.content-width - self.width);
    property <length> offset: min(max(0, self.focus-col - 1) * self.step, self.max-offset);

    Text {
        x: 0;
        y: 0;
        text: root.shelf.title;
        color: root.active ? white : #c9cdd6;
        font-size: 42 * u;
        font-weight: 700;
    }

    Rectangle {
        x: -root.offset;
        y: 84 * u;
        width: root.content-width;
        height: root.height - 84 * u;
        animate x { duration: 240ms; easing: ease-out-quint; }

        for card[index] in root.shelf.cards: CardView {
            x: index * root.step;
            y: 0;
            width: 400 * root.u;
            height: 330 * root.u;
            u: root.u;
            card: card;
            focused: root.active && index == root.focus-col;
        }
    }
}

component ShelfStack {
    in property <length> u;
    in property <[ShelfData]> shelves;
    in property <int> focus-row;
    in property <[int]> focus-cols;
    in property <bool> active;

    property <length> step: 444 * u;
    property <length> content-height: self.shelves.length * self.step + 16 * u;
    property <length> max-offset: max(0px, self.content-height - self.height);

    Rectangle {
        x: 0;
        y: -min(root.focus-row * root.step, root.max-offset);
        width: 100%;
        height: root.content-height;
        animate y { duration: 280ms; easing: ease-out-quint; }

        for shelf[index] in root.shelves: ShelfRow {
            x: 0;
            y: index * root.step;
            width: parent.width;
            height: 414 * root.u;
            u: root.u;
            shelf: shelf;
            focus-col: root.focus-cols[index];
            active: root.active && index == root.focus-row;
        }
    }
}

component Toast inherits Rectangle {
    in property <length> u;
    in property <string> heading;
    in property <string> text;
    in property <bool> voice;
    in property <bool> busy;

    border-radius: 32 * root.u;
    background: #232733;
    border-width: 1px;
    border-color: #ffffff1a;
    drop-shadow-blur: 32 * root.u;
    drop-shadow-color: #00000099;

    HorizontalLayout {
        padding-left: (root.voice ? 36 : 44) * root.u;
        padding-right: 44 * root.u;
        padding-top: 24 * root.u;
        padding-bottom: 26 * root.u;
        spacing: 24 * root.u;

        if root.voice: VerticalLayout {
            alignment: center;

            Rectangle {
                width: 22 * root.u;
                height: 22 * root.u;
                border-radius: self.width / 2;
                background: root.busy ? white : #8f95a3;
                opacity: root.busy ? 0.55 + 0.45 * sin(animation-tick() / 1.2s * 360deg) : 1;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 6 * root.u;

            if root.heading != "": Text {
                text: root.heading;
                color: #a8adb8;
                font-size: 26 * root.u;
                horizontal-alignment: root.voice ? left : center;
                wrap: word-wrap;
            }

            Text {
                text: root.text;
                color: white;
                font-size: 32 * root.u;
                font-weight: 500;
                horizontal-alignment: root.voice ? left : center;
                wrap: word-wrap;
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <[ShelfData]> home-shelves;
    in property <int> home-row;
    in property <[int]> home-cols;

    in property <bool> show-open;
    in property <string> show-title;
    in property <string> show-subtitle;
    in property <[ShelfData]> show-shelves;
    in property <int> show-row;
    in property <[int]> show-cols;

    in property <string> message;
    in property <string> voice-transcript;
    in property <string> voice-status;
    in property <bool> voice-busy;
    in property <string> empty-note;
    in property <bool> tmdb-notice;
    in property <string> details;
    in property <RatingsData> ratings;

    callback key(string) -> bool;
    callback remote-input();
    callback voice-heard();
    callback changed();
    callback playback-finished(bool, bool);
    callback position-saved();

    property <length> u: self.height / 1080;

    title: "SemmelTV";
    no-frame: true;
    preferred-width: 1280px;
    preferred-height: 720px;
    background: #0b0d12;
    default-font-family: "Inter Variable";
    forward-focus: scope;

    scope := FocusScope {
        key-pressed(event) => {
            root.key(event.text) ? accept : reject
        }

        home := ShelfStack {
            x: 96 * root.u;
            y: 96 * root.u;
            width: parent.width - 192 * root.u;
            height: parent.height - 152 * root.u;
            u: root.u;
            shelves: root.home-shelves;
            focus-row: root.home-row;
            focus-cols: root.home-cols;
            active: !root.show-open;
            opacity: root.show-open ? 0 : 1;
            animate opacity { duration: 200ms; }
        }

        if root.empty-note != "" && !root.show-open: VerticalLayout {
            alignment: center;
            spacing: 24 * root.u;
            padding-left: 200 * root.u;
            padding-right: 200 * root.u;

            Text {
                text: "Nothing to watch yet";
                color: white;
                font-size: 56 * root.u;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: root.empty-note;
                color: #a8adb8;
                font-size: 32 * root.u;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        Rectangle {
            opacity: root.show-open ? 1 : 0;
            animate opacity { duration: 200ms; }

            ShelfStack {
                x: 96 * root.u;
                y: 236 * root.u;
                width: parent.width - 192 * root.u;
                height: parent.height - 292 * root.u;
                u: root.u;
                shelves: root.show-shelves;
                focus-row: root.show-row;
                focus-cols: root.show-cols;
                active: root.show-open;
            }

            Rectangle {
                y: 0;
                height: 214 * root.u;
                background: #0b0d12;
            }

            Text {
                x: 96 * root.u;
                y: 60 * root.u;
                text: root.show-title;
                color: white;
                font-size: 68 * root.u;
                font-weight: 700;
            }

            Text {
                x: 96 * root.u;
                y: 144 * root.u;
                text: root.show-subtitle;
                color: #a8adb8;
                font-size: 30 * root.u;
            }
        }

        Rectangle {
            y: parent.height - 120 * root.u;
            height: 24 * root.u;
            background: @linear-gradient(0deg, #0b0d12 0%, #0b0d1200 100%);
        }

        Rectangle {
            y: parent.height - 96 * root.u;
            height: 96 * root.u;
            background: #0b0d12;

            HorizontalLayout {
                x: 96 * root.u;
                y: 12 * root.u;
                width: parent.width - 192 * root.u;
                height: 30 * root.u;
                spacing: 9 * root.u;
                alignment: start;

                if root.ratings.imdb != "": Rectangle {
                    width: 52 * root.u;
                    height: 24 * root.u;
                    y: 3 * root.u;
                    border-radius: 4 * root.u;
                    background: #f5c518;

                    Text {
                        text: "IMDb";
                        color: #000000;
                        font-size: 16 * root.u;
                        font-weight: 900;
                        letter-spacing: -0.3 * root.u;
                    }
                }

                if root.ratings.imdb != "": Text {
                    text: root.ratings.imdb;
                    color: #c3c7d1;
                    font-size: 24 * root.u;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                if root.ratings.imdb != "" && root.ratings.rt != "": Rectangle {
                    width: 4 * root.u;
                }

                if root.ratings.rt != "" && root.ratings.fresh: Rectangle {
                    width: 28 * root.u;

                    Path {
                        y: -2 * root.u;
                        width: 28 * root.u;
                        height: 28 * root.u;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: #fa320a;
                        commands: "M12 6C17.6 6 22 9.6 22 14.3C22 19.2 17.6 22.6 12 22.6C6.4 22.6 2 19.2 2 14.3C2 9.6 6.4 6 12 6Z";
                    }

                    Path {
                        y: -2 * root.u;
                        width: 28 * root.u;
                        height: 28 * root.u;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: #0ac855;
                        commands: "M12 4.4L13.4 6.2L16.9 5.5L14.7 7.5L16.3 9.5L12.9 8.6L12 10.3L11.1 8.6L7.7 9.5L9.3 7.5L7.1 5.5L10.6 6.2ZM11.5 5.2L11.9 1.8L12.9 1.8L12.5 5.2Z";
                    }
                }

                if root.ratings.rt != "" && !root.ratings.fresh: Rectangle {
                    width: 28 * root.u;

                    Path {
                        y: -2 * root.u;
                        width: 28 * root.u;
                        height: 28 * root.u;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: #0ac855;
                        commands: "M12 3.2L13.6 7.4L17.6 3.8L16.6 8.9L22 8.4L18 12.2L22.4 15.6L16.8 16L18.6 21.2L13.9 18L12 22.8L10.1 18L5.2 21.4L7.2 16L1.6 15.4L6.1 12.1L2.2 8.2L7.5 8.9L6.4 3.8L10.4 7.4Z";
                    }
                }

                if root.ratings.rt != "": Text {
                    text: root.ratings.rt;
                    color: #c3c7d1;
                    font-size: 24 * root.u;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                if (root.ratings.imdb != "" || root.ratings.rt != "") && root.details != "": Text {
                    text: "·";
                    color: #8f95a3;
                    font-size: 24 * root.u;
                    vertical-alignment: center;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.details;
                    color: #8f95a3;
                    font-size: 24 * root.u;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if root.tmdb-notice && !root.show-open: Text {
                x: 96 * root.u;
                y: 52 * root.u;
                text: "This application uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB.";
                color: #6c7280;
                font-size: 18 * root.u;
            }
        }

        voice-toast := Toast {
            u: root.u;
            visible: root.voice-status != "";
            heading: root.voice-transcript;
            text: root.voice-status;
            voice: true;
            busy: root.voice-busy;
            width: min(self.preferred-width, parent.width - 384 * root.u, 1200 * root.u);
            height: self.preferred-height;
            x: (parent.width - self.width) / 2;
            y: parent.height - 160 * root.u - self.height;
        }

        Toast {
            u: root.u;
            visible: root.message != "";
            text: root.message;
            width: min(self.preferred-width, parent.width - 384 * root.u, 1200 * root.u);
            height: self.preferred-height;
            x: (parent.width - self.width) / 2;
            y: parent.height - 160 * root.u - self.height
                - (voice-toast.visible ? voice-toast.height + 24 * root.u : 0);
        }
    }
}
